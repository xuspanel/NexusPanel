# Keep only TheNexusPanel, nxApp, and nxLicensing in git
/*
!/TheNexusPanel
!/nxApp
!/nxLicensing
!/.gitignore
!/README.md

# TheNexusPanel exceptions
/TheNexusPanel/node_modules/
/TheNexusPanel/.env
/TheNexusPanel/data/users.json
/TheNexusPanel/data/orders.json
/TheNexusPanel/data/invoices/

# nxLicensing exceptions
/nxLicensing/node_modules/
/nxLicensing/.env
/nxLicensing/data/users.json

# Existing ignore patterns (redundant but kept for safety)
node_modules/
data/
.env

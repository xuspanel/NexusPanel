# Keep only TheNexusPanel and nxApp in git
/*
!/TheNexusPanel
!/nxApp
!/.gitignore
!/README.md

# TheNexusPanel exceptions
/TheNexusPanel/node_modules/
/TheNexusPanel/.env
/TheNexusPanel/data/users.json
/TheNexusPanel/data/orders.json
/TheNexusPanel/data/invoices/

# Existing ignore patterns (redundant but kept for safety)
node_modules/
data/
.env

<% if (!user) { %>
<%- include('layout', { body: '<section class="n-section"><div class="n-auth-card"><h2>Sign in</h2><a href="/login" class="n-btn n-btn-primary">Sign In</a></div></section>' }) %>
<% } else { %>
<%
const body = `
<section class="n-section"><h2 class="n-section-title">My License Keys</h2>
<div id="licensesList"><div class="n-loading">Loading licenses...</div></div></section>
`; %>
<%- include('layout', { body: body }) %>
<script>
(async function(){
  var el=document.getElementById('licensesList');
  try{
    var r=await fetch('/api/orders',{credentials:'same-origin'});
    if(r.status===401){el.innerHTML='<div class="n-empty"><a href="/login">Sign in</a> to view licenses.</div>';return}
    if(!r.ok){el.innerHTML='<div class="n-empty">Failed to load. <a href="#" onclick="location.reload()">Retry</a></div>';return}
    var orders=await r.json();
    var keys=[];
    orders.forEach(function(o){if(o.licenseKeys)o.licenseKeys.forEach(function(k){keys.push({key:k,orderId:o.id,status:o.status,date:o.createdAt})})});
    if(!keys.length){el.innerHTML='<div class="n-empty">No license keys yet. <a href="/pricing">Purchase a license</a></div>';return}
    el.innerHTML=keys.map(function(k){
      return '<div class="n-license-card"><div class="n-license-key">'+k.key+'<button class="n-btn n-btn-sm" onclick="navigator.clipboard.writeText(\''+k.key+'\')">Copy</button></div><div class="n-license-meta">Status: '+k.status+' · Order: '+k.orderId.substring(0,12)+'... · '+new Date(k.date).toLocaleDateString()+'</div></div>';
    }).join('')
  }catch(e){el.innerHTML='<div class="n-empty">Failed to load. <a href="#" onclick="location.reload()">Retry</a></div>'}
})()
</script>
<% } %>

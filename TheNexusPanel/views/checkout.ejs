<% if (!user) { %>
<%- include('layout', { body: '<section class="n-section"><div class="n-auth-card"><h2>Sign in to checkout</h2><a href="/login" class="n-btn n-btn-primary">Sign In</a></div></section>' }) %>
<% } else { %>
<%
const body = `
<section class="n-section"><h2 class="n-section-title">Checkout</h2>
<div class="n-checkout-grid">
  <div class="n-checkout-form">
    <h3>Contact Information</h3>
    <div class="n-form-group"><label>Email</label><input id="checkoutEmail" value="` + (user.email || '') + `" class="n-input"></div>
    <div class="n-form-group"><label>Name</label><input id="checkoutName" value="` + (user.name || '') + `" class="n-input"></div>
    <h3 style="margin-top:20px">Payment Method</h3>
    <div class="n-payment-info">
      <p>This is a simulation checkout. Your license keys will be generated immediately upon order placement.</p>
    </div>
    <button class="n-btn n-btn-lg n-btn-primary n-btn-block" onclick="placeOrder()" id="checkoutBtn">Place Order</button>
    <div class="n-form-msg" id="checkoutMsg"></div>
  </div>
  <div class="n-checkout-summary" id="checkoutSummary"><div class="n-loading">Loading...</div></div>
</div></section>
`; %>
<%- include('layout', { body: body }) %>
<script src="/js/checkout.js"></script>
<% } %>

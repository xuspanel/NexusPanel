<%
const isLoggedIn = !!user;
const startUrl = isLoggedIn ? '#' : '/register';
const startAttr = isLoggedIn ? 'onclick="addToCart(\'Starter\',29,1,12);return false"' : '';
const proAttr = isLoggedIn ? 'onclick="addToCart(\'Professional\',79,5,12);return false"' : '';
const bizAttr = isLoggedIn ? 'onclick="addToCart(\'Business\',149,10,12);return false"' : '';
const entAttr = isLoggedIn ? 'onclick="addToCart(\'Enterprise\',299,999,12);return false"' : '';
const body = `
<section class="n-hero">
  <div class="n-hero-bg"></div>
  <div class="n-hero-content">
    <h1 class="n-hero-title">Control Your <span class="n-gradient">Server</span><br>Like Never Before</h1>
    <p class="n-hero-sub">NexusPanel is the all-in-one VPS control panel that gives you complete power over files, databases, Docker, domains, email, security, and more from a single, beautiful dashboard.</p>
    <div class="n-hero-actions">
      ` + (isLoggedIn ? '<a href="/docs/installation" class="n-btn n-btn-lg n-btn-primary">Install Now</a>' : '<a href="/register" class="n-btn n-btn-lg n-btn-primary">Get Started Free</a>') + `
      <a href="/docs" class="n-btn n-btn-lg n-btn-outline">View Documentation</a>
    </div>
    <div class="n-hero-stats">
      <div class="n-hero-stat"><strong>24+</strong><span>Features</span></div>
      <div class="n-hero-stat"><strong>100%</strong><span>Open Source</span></div>
      <div class="n-hero-stat"><strong>1-Click</strong><span>Install</span></div>
    </div>
  </div>
</section>

<section class="n-section">
  <h2 class="n-section-title">Everything You Need to <span class="n-gradient">Run Your VPS</span></h2>
  <p class="n-section-sub">One panel. Complete control. No compromises.</p>
  <div class="n-features-grid">
    <div class="n-feature-card"><div class="n-feature-icon">📁</div><h3>File Manager</h3><p>Browse, upload, edit, archive files. Full code editor with Ace syntax highlighting, global search, batch operations, visual permissions editor.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">💻</div><h3>Terminal</h3><p>Interactive web terminal via xterm.js + WebSocket. Full bash shell with preset commands, tabs, and auto-reconnect.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">🐳</div><h3>Docker Manager</h3><p>Container management with Compose project grouping. Visual status indicators, log viewer, start/stop/restart actions.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">🗄️</div><h3>Databases</h3><p>PostgreSQL management. Browse tables and schemas, run SQL queries with live results, view extensions.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">✉️</div><h3>Email Manager</h3><p>Create accounts, manage quotas, webmail with inbox, folders, compose, and send. Full Maildir support.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">🌐</div><h3>Domains & SSL</h3><p>Nginx virtual host config editor. Let's Encrypt SSL certificates with one-click issue and auto-renewal.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">🛡️</div><h3>Virus Scanner</h3><p>ClamAV-powered malware detection. Scan targets (home, mail, web, custom). Quarantine with restore/delete.</p></div>
    <div class="n-feature-card"><div class="n-feature-icon">⚙️</div><h3>Service Manager</h3><p>Control systemd services. Start, stop, restart, and view detailed status for all system services.</p></div>
  </div>
  <div style="text-align:center;margin-top:24px">
    <a href="/docs" class="n-btn n-btn-outline">View All 24+ Features</a>
  </div>
</section>

<section class="n-section n-section-dark">

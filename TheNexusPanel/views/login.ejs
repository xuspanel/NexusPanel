<% const body = `
<section class="n-auth-section">
  <div class="n-auth-card">
    <h2>Sign In</h2>
    <p>Access your NexusPanel account</p>
    <div class="n-form-error" id="loginError"></div>
    <form id="loginForm" onsubmit="return doLogin(event)">
      <div class="n-form-group"><label>Email</label><input type="email" id="loginEmail" class="n-input" required></div>
      <div class="n-form-group"><label>Password</label><input type="password" id="loginPassword" class="n-input" required></div>
      <button type="submit" class="n-btn n-btn-primary n-btn-block">Sign In</button>
    </form>
    <p class="n-auth-footer">Don't have an account? <a href="/register">Register</a></p>
  </div>
</section>
`; %>
<%- include('layout', { body: body }) %>
<script src="/js/auth.js"></script>

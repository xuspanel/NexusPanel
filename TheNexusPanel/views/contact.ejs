<% const body = `
<section class="n-section"><h2 class="n-section-title">Contact Us</h2><p class="n-section-sub">Have questions? We'd love to hear from you.</p>
<div class="n-contact-card">
  <div class="n-form-msg" id="contactMsg"></div>
  <form onsubmit="return sendContact(event)">
    <div class="n-form-group"><label>Name</label><input type="text" id="contactName" class="n-input" required></div>
    <div class="n-form-group"><label>Email</label><input type="email" id="contactEmail" class="n-input" required></div>
    <div class="n-form-group"><label>Subject</label><input type="text" id="contactSubject" class="n-input" required></div>
    <div class="n-form-group"><label>Message</label><textarea id="contactMessage" class="n-input" rows="5" required></textarea></div>
    <button type="submit" class="n-btn n-btn-primary">Send Message</button>
  </form>
</div>
<div style="text-align:center;margin-top:32px;color:var(--text-secondary)"><p>Or email us directly at <a href="mailto:nxp@s2u.me" style="color:var(--accent)">nxp@s2u.me</a></p></div></section>
`; %>
<%- include('layout', { body: body }) %>
<script>
async function sendContact(e){e.preventDefault();
  var msg=document.getElementById('contactMsg');
  try{var r=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({name:document.getElementById('contactName').value,email:document.getElementById('contactEmail').value,subject:document.getElementById('contactSubject').value,message:document.getElementById('contactMessage').value})});
  var d=await r.json();if(!r.ok)throw new Error(d.error);
  msg.className='n-form-msg success';msg.textContent='Message sent! We will get back to you soon.';document.querySelector('form').reset()}catch(e){msg.className='n-form-msg error';msg.textContent=e.message}}</script>

<% if (!user) { %>
<% const body = '<section class="n-section"><div class="n-auth-card"><h2>Please sign in</h2><a href="/login" class="n-btn n-btn-primary">Sign In</a></div></section>'; %>
<%- include('layout', { body: body }) %>
<% } else { %>
<%
const body = `
<section class="n-section">
  <div class="n-profile-card">
    <h2>Profile Settings</h2>
    <div class="n-form-group"><label>Name</label><input value="` + (user.name || '') + `" disabled class="n-input"></div>
    <div class="n-form-group"><label>Email</label><input id="profEmail" value="` + (user.email || '') + `" class="n-input"><button class="n-btn n-btn-sm n-btn-primary" onclick="updateEmail()">Save</button></div>
    <hr>
    <h3>Change Password</h3>
    <div class="n-form-group"><label>Current Password</label><input type="password" id="profCurr" class="n-input"></div>
    <div class="n-form-group"><label>New Password</label><input type="password" id="profNew" class="n-input"></div>
    <button class="n-btn n-btn-primary" onclick="updatePassword()">Change Password</button>
    <div class="n-form-msg" id="profMsg"></div>
  </div>
</section>
`; %>
<%- include('layout', { body: body }) %>
<script>
async function api(m,p,b){var o={method:m,headers:{'Content-Type':'application/json'}};if(b)o.body=JSON.stringify(b);var r=await fetch(p,o);var d=await r.json();if(!r.ok)throw new Error(d.error);return d}
function msg(t,c){var el=document.getElementById('profMsg');el.textContent=t;el.className='n-form-msg '+(c||'success')}
async function updateEmail(){try{await api('PUT','/api/profile/email',{email:document.getElementById('profEmail').value});msg('Email updated','success')}catch(e){msg(e.message,'error')}}
async function updatePassword(){try{await api('PUT','/api/profile/password',{currentPassword:document.getElementById('profCurr').value,newPassword:document.getElementById('profNew').value});msg('Password changed','success')}catch(e){msg(e.message,'error')}}
</script>
<% } %>

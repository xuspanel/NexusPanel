<%
var post = locals.post;
if (!post) {
  var body = '<section class="n-section n-docs"><h1>Post not found</h1><a href="/blog">Back to Blog</a></section>';
} else {
  var md = post.body || '';
  if (md.trim().startsWith('<')) {
    // HTML from Quill - render as-is
  } else {
    md = md.replace(/^### (.+)$/gm, '<h3>$1</h3>');
    md = md.replace(/^## (.+)$/gm, '<h2>$1</h2>');
    md = md.replace(/^# (.+)$/gm, '<h1>$1</h1>');
    md = md.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
    md = md.replace(/`([^`]+)`/g, '<code>$1</code>');
    md = md.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>');
    md = md.replace(/\n/g, '<br>');
  }
  var body = '<section class="n-section n-docs"><a href="/blog" style="color:var(--text3)">Back to Blog</a>'
    + '<h1 style="margin-top:12px">' + post.title + '</h1>'
    + '<p style="color:var(--text3)">' + (new Date(post.date)).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + ' · ' + (post.author || 'NexusPanel Team') + '</p>'
    + '<div class="n-blog-content">' + md + '</div>';
  if (user && user.role === 'admin') {
    body += '<div style="margin-top:32px"><form method="post" action="/blog/' + post.slug + '/delete" onsubmit="return confirm(\'Delete?\')"><button class="n-btn n-btn-danger">Delete Post</button></form></div>';
  }
  body += '</section>';
}
%>
<%- include('../layout', { body: body }) %>

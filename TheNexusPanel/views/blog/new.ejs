<% if (!user || user.role !== 'admin') { %>
<%- include('../layout', { body: '<section class="n-section"><div class="n-auth-card"><h2>Admin only</h2></div></section>' }) %>
<% } else { %>
<%
var body = '<section class="n-section n-docs"><h1>New Blog Post</h1>'
  + '<form method="post" action="/api/blog"><div class="n-form-group"><label>Title</label><input name="title" class="n-input" required></div>'
  + '<div class="n-form-group"><label>Slug (e.g. my-post)</label><input name="slug" class="n-input" required></div>'
  + '<div class="n-form-group"><label>Date</label><input name="date" type="date" class="n-input" required></div>'
  + '<div class="n-form-group"><label>Excerpt</label><input name="excerpt" class="n-input"></div>'
  + '<div class="n-form-group"><label>Tags (comma-separated)</label><input name="tags" class="n-input"></div>'
  + '<div class="n-form-group"><label>Content (Markdown)</label><textarea name="body" class="n-input" rows="15" required></textarea></div>'
  + '<button class="n-btn n-btn-primary">Publish</button></form></section>';
%>
<%- include('../layout', { body: body }) %>
<% } %>

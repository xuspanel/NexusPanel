<% if (!user || user.role !== 'admin') { %>
<%- include('../layout', { body: '<section class="n-section n-auth-section"><div class="n-auth-card"><h2>Admin Only</h2><p>Please sign in as an admin to create blog posts.</p><a href="/login" class="n-btn n-btn-primary">Sign In</a></div></section>' }) %>
<% } else { %>
<%
var body = '';
body += '<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">';
body += '<style>.ql-editor{min-height:300px;font-size:14px;line-height:1.6}.ql-toolbar.ql-snow{border-radius:8px 8px 0 0;border-color:var(--border);background:rgba(255,255,255,0.03)}.ql-container.ql-snow{border-radius:0 0 8px 8px;border-color:var(--border);font-family:inherit}</style>';
body += '<section class="n-section n-docs"><h1>New Blog Post</h1>';
body += '<div class="n-form-group"><label>Title</label><input name="title" id="blogTitle" class="n-input" required></div>';
body += '<div class="n-form-group"><label>Slug (e.g. my-post)</label><input name="slug" id="blogSlug" class="n-input" required></div>';
body += '<div class="n-form-group"><label>Date</label><input name="date" id="blogDate" type="date" class="n-input" required></div>';
body += '<div class="n-form-group"><label>Excerpt</label><input name="excerpt" id="blogExcerpt" class="n-input"></div>';
body += '<div class="n-form-group"><label>Tags (comma-separated)</label><input name="tags" id="blogTags" class="n-input"></div>';
body += '<div class="n-form-group"><label>Content</label><div id="blogEditor" style="background:rgba(255,255,255,0.04);border-radius:8px"></div></div>';
body += '<button class="n-btn n-btn-primary" onclick="publishPost()">Publish</button></section>';
%>
<%- include('../layout', { body: body }) %>
<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
var blogQuill;
document.addEventListener('DOMContentLoaded', function() {
  var d = new Date();
  document.getElementById('blogDate').value = d.toISOString().substring(0, 10);
  blogQuill = new Quill('#blogEditor', {
    theme: 'snow',
    modules: {
      toolbar: [
        [{ header: [1, 2, 3, false] }],
        ['bold', 'italic', 'underline', 'strike'],
        [{ color: [] }, { background: [] }],
        [{ list: 'ordered' }, { list: 'bullet' }],
        [{ indent: '-1' }, { indent: '+1' }],
        [{ align: [] }],
        ['blockquote', 'code-block'],
        ['link', 'image'],
        ['clean']
      ]
    },
    placeholder: 'Write your blog post...'
  });
});

async function publishPost() {
  var title = document.getElementById('blogTitle').value.trim();
  var slug = document.getElementById('blogSlug').value.trim();
  var date = document.getElementById('blogDate').value;
  var excerpt = document.getElementById('blogExcerpt').value.trim();
  var tags = document.getElementById('blogTags').value.trim();
  var body = blogQuill ? blogQuill.root.innerHTML : '';
  if (!title || !slug) { alert('Title and slug are required'); return; }
  try {
    var res = await fetch('/api/blog', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ title, slug, date, excerpt, tags, body })
    });
    if (res.ok) window.location.href = '/blog/' + slug;
    else alert((await res.json()).error || 'Failed to publish');
  } catch(e) { alert(e.message); }
}
<% } %>

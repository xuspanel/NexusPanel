<%
var posts = locals.posts || [];
var tagFilter = locals.tag || '';
var body = '<section class="n-section n-docs"><h1>Blog &amp; Updates</h1><p>NexusPanel announcements, release notes, and tutorials.</p>';

if (!posts.length) {
  body += '<div class="n-empty">No posts found. Check back soon!</div>';
} else {
  body += '<div class="n-blog-grid">';
  posts.forEach(function(p) {
    body += '<a href="/blog/' + p.slug + '" class="n-blog-card">'
      + '<span class="n-blog-date">' + (new Date(p.date)).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) + '</span>'
      + '<h3>' + p.title + '</h3>'
      + '<p>' + (p.excerpt || (p.body || '').substring(0, 150) + '...') + '</p>'
      + (p.tags ? '<div class="n-blog-tags">' + p.tags.map(function(t) { return '<span class="n-blog-tag">' + t + '</span>'; }).join('') + '</div>' : '')
      + '</a>';
  });
  body += '</div>';
}

if (user && user.role === 'admin') {
  body += '<div style="margin-top:32px;border-top:1px solid var(--border);padding-top:20px"><a href="/blog/new" class="n-btn n-btn-primary">+ New Post</a></div>';
}
body += '</section>';
%>
<%- include('../layout', { body: body }) %>
